# KasGate example environment. Copy to .env. Never commit real values.
X402_CHAIN=mock                 # mock | real (real = Kaspa Testnet-10 only)
X402_CONFIG=config/routes.yaml
X402_DB=data/gateway.sqlite
X402_KEYSTORE_DIR=.secrets/keystore
PORT=8402
TN10_WALLET_KEY_FILE=.secrets/tn10-wallet.key
TN10_WRPC_URL=
X402_PNN_DEFAULT_QUORUM=1
X402_DASHBOARD_PASSWORD_HASH=   # output of: npm run hash-password
X402_INSECURE_COOKIE=0          # 1 only for local http testing
PAYER_ADDRESS=kaspatest:YOUR_PAYER_ADDRESS
MERCHANT_ADDRESS=kaspatest:YOUR_MERCHANT_ADDRESS
